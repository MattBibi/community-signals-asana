# Asana personal access token: https://app.asana.com/0/my-apps
ASANA_PAT=
# Optional: defaults to your first workspace and "Community Triage"
# ASANA_WORKSPACE_GID=
# ASANA_PROJECT_NAME=Community Triage

# Fine-grained GitHub token, Issues read/write on the sandbox repo
GITHUB_TOKEN=
# The repo whose issues become signals, as owner/name
GITHUB_REPO=

# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
